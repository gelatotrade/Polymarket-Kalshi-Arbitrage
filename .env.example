# ===========================================
# Polymarket-Kalshi Arbitrage Bot Configuration
# ===========================================

# ---------------- Kalshi ----------------
# 1. Sign in to https://kalshi.com and go to Profile -> Account -> API Keys.
# 2. Create an API Key. Kalshi will display the key id once and download an
#    RSA private key file (.pem). Save the .pem locally; we never upload it.
# 3. Put the key id in KALSHI_API_KEY and the path to the .pem in
#    KALSHI_PRIVATE_KEY_PATH (or paste the PEM into KALSHI_PRIVATE_KEY_PEM).
#    The API uses RSA-PSS-SHA256 signing — HMAC is no longer supported.
KALSHI_API_KEY=your_kalshi_api_key_id_here
KALSHI_PRIVATE_KEY_PATH=./kalshi_rsa.pem
# KALSHI_PRIVATE_KEY_PEM=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# KALSHI_PRIVATE_KEY_PASSWORD=        # only if your PEM is password-protected
# KALSHI_API_SECRET=                   # legacy HMAC secret, kept for tests only
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2
KALSHI_DEMO_MODE=false                 # use the demo endpoint while testing

# ---------------- Polymarket ----------------
# Polymarket trading goes through the official py-clob-client SDK, which
# handles EIP-712 typed data signing. You need:
#   - a Polygon wallet private key with USDC (the "funder" wallet)
#   - that wallet to be approved for the Polymarket exchange contracts
# The first time you trade, the SDK derives L2 API credentials from your
# wallet signature; you don't need to fill API_KEY / SECRET / PASSPHRASE
# manually unless you've created a key pair via the CLOB UI.
POLYMARKET_PRIVATE_KEY=0xyour_polygon_private_key_here
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# ---------------- Web3 (Polygon) ----------------
# Free Alchemy / Infura plans work; the public RPC is rate-limited.
WEB3_PROVIDER_URL=https://polygon-mainnet.g.alchemy.com/v2/your_api_key
POLYGON_CHAIN_ID=137

# ---------------- Application ----------------
HOST=0.0.0.0
PORT=8080
DEBUG=false

# ---------------- Trading guardrails ----------------
DRY_RUN=true                          # leave true until you've verified e2e
MIN_ARBITRAGE_PROFIT_PCT=1.0
MAX_TRADE_SIZE_USD=100
MAX_POSITION_USD=1000
AUTO_TRADE_ENABLED=false

# ---------------- Logging ----------------
LOG_LEVEL=INFO
LOG_FILE=logs/arbitrage.log
