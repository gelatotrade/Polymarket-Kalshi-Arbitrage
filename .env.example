# ===========================================
# Polymarket-Kalshi Arbitrage Bot Configuration
# ===========================================

# Kalshi API Credentials
# Get your API key from: https://kalshi.com/settings/api
KALSHI_API_KEY=your_kalshi_api_key_here
KALSHI_API_SECRET=your_kalshi_api_secret_here
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2

# Polymarket Configuration
# Polymarket uses wallet-based authentication
POLYMARKET_API_URL=https://clob.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com

# Web3 Configuration
WEB3_PROVIDER_URL=https://polygon-mainnet.g.alchemy.com/v2/your_api_key
POLYGON_CHAIN_ID=137

# Application Settings
HOST=0.0.0.0
PORT=8080
DEBUG=false

# Trading Configuration
MIN_ARBITRAGE_PROFIT_PCT=1.0
MAX_TRADE_SIZE_USD=100
AUTO_TRADE_ENABLED=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/arbitrage.log
